<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <!-- LSLib / LSLibNative are x86; must match 32-bit process -->
    <PlatformTarget>x86</PlatformTarget>
    <UseWpf>true</UseWpf>
    <RootNamespace>D_OS_Save_Editor</RootNamespace>
    <AssemblyName>D-OS Save Editor</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>1.1.0.*</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="11.0.2" />
    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="LSLib">
      <HintPath>lslib\LSLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.WindowsAPICodePack">
      <HintPath>..\packages\winapicp.1.1\lib\Microsoft.WindowsAPICodePack.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.WindowsAPICodePack.ExtendedLinguisticServices">
      <HintPath>..\packages\winapicp.1.1\lib\Microsoft.WindowsAPICodePack.ExtendedLinguisticServices.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.WindowsAPICodePack.Sensors">
      <HintPath>..\packages\winapicp.1.1\lib\Microsoft.WindowsAPICodePack.Sensors.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.WindowsAPICodePack.Shell">
      <HintPath>..\packages\winapicp.1.1\lib\Microsoft.WindowsAPICodePack.Shell.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.WindowsAPICodePack.ShellExtensions">
      <HintPath>..\packages\winapicp.1.1\lib\Microsoft.WindowsAPICodePack.ShellExtensions.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="lslib\LSLib.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="lslib\LSLibNative.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="lslib\LZ4.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="lslib\Newtonsoft.Json.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="lslib\OpenTK.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="lslib\QUT.ShiftReduceParser.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="lslib\zlib.net.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>
</Project>
